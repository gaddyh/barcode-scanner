# ── Barcode Scanner Service — environment variables ──────────────────────
# Copy this file to .env and fill in the values.
# On Render (or any PaaS), set these in the dashboard or via render.yaml.

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Barcode Scanner Service
APP_ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=15728640
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Gemini (required for analyze_image barcode audit) ───────────────────
GEMINI_API_KEY=

# ── LangSmith tracing (optional) ────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=barcode-scanner
LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=
# Required only for programmatic dashboard provisioning:
# LANGSMITH_PROJECT_ID=<tracing-project-uuid>
# LANGSMITH_TENANT_ID=<langsmith-tenant-uuid>

# ── Database (required for persistence and customer/branch catalog) ───────
DATABASE_URL=
