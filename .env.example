# ── Barcode Scanner Service — environment variables ──────────────────────
# Copy this file to .env and fill in the values.
# On Render (or any PaaS), set these in the dashboard or via render.yaml.

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Barcode Scanner Service
APP_ENV=production
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=15728640
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── 360dialog WhatsApp (required — app will not boot without D360_API_KEY) ─
D360_API_KEY=
D360_API_BASE_URL=https://waba-v2.360dialog.io
WEBHOOK_AUTH_MODE=none
# WEBHOOK_BEARER_TOKEN=
# WEBHOOK_BASIC_USER=
# WEBHOOK_BASIC_PASS=

# ── Gemini (required for analyze_image barcode audit) ───────────────────
GEMINI_API_KEY=

# ── Transcription (required if audio messages are expected) ─────────────
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# OPENAI_MODEL=gpt-4o-mini
# For Modal Whisper provider instead of OpenAI:
# MODAL_TRANSCRIPTION_URL=
# MODAL_TRANSCRIPTION_KEY=
# MODAL_TRANSCRIPTION_SECRET=
# MODAL_TRANSCRIPTION_TIMEOUT_SECONDS=180

# ── LangSmith tracing (optional) ────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=barcode-scanner
LANGSMITH_TRACING_V2=false
# LANGSMITH_ENDPOINT=

# ── Database (optional — not used by the barcode/WhatsApp flow) ──────────
# DATABASE_PATH=tami.db
# DATABASE_URL=
